# Vane — environment variables
# Copy to `.env` (git-ignored) and fill in what you need. The backend
# (api/main.py) loads `.env` automatically on startup. Everything here is
# optional except ANTHROPIC_API_KEY, and only the chat endpoint needs that —
# simulation, temporal, stress tests, and the whole web UI run without any key.

# ─── Chat (Anthropic) ───────────────────────────────────────────────────────
# Required only for the natural-language chat interface. Get a key at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional model override. Default: claude-sonnet-5
# ANTHROPIC_MODEL=claude-sonnet-5

# ─── Live events (optional) ─────────────────────────────────────────────────
# Ticketmaster Discovery API enables live Las Vegas event lookups. When unset,
# the events source reports available=false rather than returning fake data.
TICKETMASTER_API_KEY=

# ─── Persistence (optional, Supabase) ───────────────────────────────────────
# Enables shareable run URLs, persistent chat, and the scenario library. When
# unset the app still runs — simulations just aren't saved and /scenarios
# returns []. Use the service_role key (backend only; never the anon key).
#   1. Create a project at https://supabase.com/dashboard
#   2. Apply supabase/migrations/*.sql (SQL editor or `supabase db push`)
#   3. Seed the scenario library: python supabase/seed.py
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ─── Production hardening (optional, only if you self-host publicly) ─────────
# Set APP_ENV=production to hide /docs and refuse a wildcard CORS origin.
# APP_ENV=production
# Pin CORS to your frontend origin(s), comma-separated. Required in production;
# wildcard is dev-only. Example:
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
# Pin accepted Host headers, comma-separated (defense against Host injection):
# TRUSTED_HOSTS=api.example.com
# Serve the built web/dist from the API process (single-origin deploy):
# SERVE_WEB_DIST=1

# ─── Frontend ───────────────────────────────────────────────────────────────
# Where the web app sends API calls. Defaults to /api (proxied to the backend
# by vite.config.js in dev). Set to a full origin to call the backend directly.
# VITE_API_URL=http://localhost:8000
